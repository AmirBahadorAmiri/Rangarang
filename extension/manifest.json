{
  "manifest_version": 3,
  "name": "رنگارنگ — Rangarang",
  "short_name": "رنگارنگ",
  "version": "1.0.0",
  "description": "مدیریت پالت رنگ؛ کاملاً محلی و بدون نیاز به سرور یا وبسایت.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "رنگارنگ",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  }
}
